ENQUIRY_BACKEND_URL=http://127.0.0.1:8080
# Must match the Go backend's secret. Private; never use PUBLIC_ prefixes.
ENQUIRY_PROXY_SECRET=replace-with-a-long-random-secret

# Go backend credentials (also configure backend/.env).
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM="InceptChange <hello@inceptchange.com>"

# Private admin and Supabase database configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ADMIN_EMAILS=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
